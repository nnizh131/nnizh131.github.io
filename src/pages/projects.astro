---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { SITE } from "@/config";

const projects = await getCollection("projects", ({ data }) => !data.draft);
---

<Layout title={`Projects | ${SITE.title}`}>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout">
    <section id="projects" class="mb-28">
      <h1 class="text-2xl tracking-wider sm:text-3xl">Projects</h1>
      <p class="mt-2 mb-8 text-foreground/70">Things I've built or am currently working on.</p>
      <ul class="grid gap-4 sm:grid-cols-2">
        {
          projects.map(project => (
            <li class="group flex min-h-44 flex-col rounded-lg border border-border bg-background p-5 transition-shadow hover:shadow-md">
              <div class="flex items-start justify-between gap-2">
                <a
                  href={`/projects/${project.id}`}
                  class="truncate text-base font-semibold text-accent decoration-dashed underline-offset-4 hover:underline"
                >
                  {project.data.title}
                </a>
                <div class="flex shrink-0 items-center gap-2">
                  {project.data.paper && (
                    <a
                      href={project.data.paper}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${project.data.title} paper`}
                      class="text-foreground/50 hover:text-accent"
                    >
                      <img
                        src={`https://www.google.com/s2/favicons?domain=${new URL(project.data.paper).hostname.replace("www.", "")}&sz=16`}
                        width="16"
                        height="16"
                        alt="paper"
                        class="rounded-sm opacity-60 hover:opacity-100"
                      />
                    </a>
                  )}
                  {project.data.github && (
                    <a
                      href={project.data.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${project.data.title} on GitHub`}
                      class="text-foreground/50 hover:text-accent"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" /></svg>
                    </a>
                  )}
                </div>
              </div>
              <p class="mt-2 text-sm text-foreground/70 line-clamp-2">{project.data.description}</p>
              {project.data.tags.length > 0 && (
                <ul class="mt-auto pt-4 flex flex-wrap gap-2">
                  {project.data.tags.map(tag => (
                    <li class="rounded-full bg-muted px-2.5 py-0.5 text-xs text-foreground/70">
                      {tag}
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    sessionStorage.setItem("backUrl", "/projects");
  });
</script>
